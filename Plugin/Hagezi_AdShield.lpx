#!homepage=https://github.com/hagezi/dns-blocklists
#!tag=广告拦截,Ad-Shield,anti-AD,远程更新

[Rule]
# Yahoo News 页面兼容：放行 UDC 和该精确 HTML 加载域名，不放行整个 html-load.com 或 yahoo.com
DOMAIN,udc.yahoo.com,DIRECT
DOMAIN,yahoo-homepage.html-load.com,DIRECT
