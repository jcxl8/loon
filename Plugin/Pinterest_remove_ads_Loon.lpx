#!name=Pinterest 去广告（增强版·远程更新）
#!desc=移除首页、相关 Pin 和搜索结果中的推广 Pin，并同步 HaGeZi 的 Pinterest 广告与跟踪域名
#!author=jcxl8 / HaGeZi / Codex
#!homepage=https://github.com/jcxl8/loon
#!tag=Pinterest,去广告,远程更新

[Rule]
# Static privacy and advertising endpoints
# Core/regional Pinterest sites such as ar.pinterest.com are intentionally not blocked.
DOMAIN,cookiesync.mparticle.com,REJECT
DOMAIN,d.agkn.com,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,ads-dev.pinterest.com,REJECT
DOMAIN-SUFFIX,ads.pinterest.com,REJECT
DOMAIN-SUFFIX,analytics-dev.pinterest.com,REJECT
DOMAIN-SUFFIX,analytics.pinterest.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,appsflyersdk.com,REJECT
DOMAIN-SUFFIX,bidr.io,REJECT
DOMAIN-SUFFIX,bouncex.net,REJECT
DOMAIN-SUFFIX,bugsnag.com,REJECT
DOMAIN-SUFFIX,ct.pinterest.com,REJECT
DOMAIN-SUFFIX,demdex.net,REJECT
DOMAIN-SUFFIX,doubleclick-cn.net,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,log.pinterest.com,REJECT
DOMAIN-SUFFIX,log.pinterest.com.eg,REJECT
DOMAIN-SUFFIX,sc.omtrdc.net,REJECT
DOMAIN-SUFFIX,snapkit.com,REJECT
DOMAIN-SUFFIX,trk.pinterest.com,REJECT
DOMAIN-SUFFIX,trk2.pinterest.com,REJECT
DOMAIN-SUFFIX,zenimpact.io,REJECT

[Rewrite]
^https:\/\/api\.pinterest\.com\/v\d+\/feeds\/home\? response-body-json-jq '.data |= map(select(.is_promoted == false or .is_promoted == "false"))'
^https:\/\/api\.pinterest\.com\/v\d+\/pins\/\d+\/related\/modules\? response-body-json-jq '.data |= map(select(.is_promoted == false or .is_promoted == "false"))'
^https:\/\/api\.pinterest\.com\/v\d+\/search\/ response-body-json-jq 'if (.resource_response.data.results? | type) == "array" then .resource_response.data.results |= map(select((.story_type? != "shopping_spotlight") and (.story_type? != "slp_search_recommendation") and (.story_type? != "related_searches_organic") and (.title.format? != "购物焦点") and (.is_promoted? != true) and (.is_promoted? != "true") and (.pin_promotion_id? == null) and (.promoted_pin_id? == null) and (.ad_pin_id? == null) and (.promotion_id? == null))) elif (.resource_response.data? | type) == "array" then .resource_response.data |= map(select((.story_type? != "shopping_spotlight") and (.story_type? != "slp_search_recommendation") and (.story_type? != "related_searches_organic") and (.title.format? != "购物焦点") and (.is_promoted? != true) and (.is_promoted? != "true") and (.pin_promotion_id? == null) and (.promoted_pin_id? == null) and (.ad_pin_id? == null) and (.promotion_id? == null))) elif (.data.results? | type) == "array" then .data.results |= map(select((.story_type? != "shopping_spotlight") and (.story_type? != "slp_search_recommendation") and (.story_type? != "related_searches_organic") and (.title.format? != "购物焦点") and (.is_promoted? != true) and (.is_promoted? != "true") and (.pin_promotion_id? == null) and (.promoted_pin_id? == null) and (.ad_pin_id? == null) and (.promotion_id? == null))) elif (.data? | type) == "array" then .data |= map(select((.story_type? != "shopping_spotlight") and (.story_type? != "slp_search_recommendation") and (.story_type? != "related_searches_organic") and (.title.format? != "购物焦点") and (.is_promoted? != true) and (.is_promoted? != "true") and (.pin_promotion_id? == null) and (.promoted_pin_id? == null) and (.ad_pin_id? == null) and (.promotion_id? == null))) else . end'
^https:\/\/api\.pinterest\.com\/v\d+\/batch\/ response-body-json-jq 'walk(if type == "object" and ((.is_promoted? == true) or (.is_promoted? == "true") or (.pin_promotion_id? != null) or (.promoted_pin_id? != null) or (.ad_pin_id? != null) or (.promotion_id? != null) or (.is_sponsored? == true) or (.is_sponsored? == "true")) then empty else . end)'

[MITM]
hostname = %APPEND% api.pinterest.com
